{
  "name": "discord-agent-pilot",
  "version": "0.0.0",
  "description": "A Discord bot that monitors and controls Claude Code running in tmux via Discord threads",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint:tsc": "tsc --noEmit",
    "lint:eslint": "eslint src/",
    "lint:prettier": "prettier --check src/",
    "lint": "run-s lint:*",
    "fix:eslint": "eslint src/ --fix",
    "fix:prettier": "prettier --write src/",
    "fix": "run-s fix:*"
  },
  "packageManager": "pnpm@12.23.0+sha512.02da94ffaf133f46074322afe552f90d40b5f71ae259aefbccdacc5085b1d617e98d65e0131f5748b9b67445978ee5055d7d59a473f1eef0d504854fefcd5975",
  "devDependencies": {
    "@book000/eslint-config": "1.17.14",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.1.1",
    "eslint": "10.15.0",
    "fauxcord": "github:tomacheese/fauxcord#3478a19a936b07348a5eebb81874c26b8c2dc090",
    "npm-run-all2": "9.1.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  },
  "dependencies": {
    "better-sqlite3": "13.2.0",
    "claude-code-jsonl-parser": "0.1.3",
    "discord.js": "14.28.1",
    "tsx": "4.23.15",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  }
}
