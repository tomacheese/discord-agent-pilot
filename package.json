{
  "name": "discord-agent-pilot",
  "version": "0.0.0",
  "description": "A Discord bot that monitors and controls Claude Code running in tmux via Discord threads",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint:tsc": "tsc --noEmit",
    "lint:eslint": "eslint src/",
    "lint:prettier": "prettier --check src/",
    "lint": "run-s lint:*",
    "fix:eslint": "eslint src/ --fix",
    "fix:prettier": "prettier --write src/",
    "fix": "run-s fix:*"
  },
  "packageManager": "pnpm@12.17.0+sha512.b8d223ebec04b580a89ed206daa71d1bccb6a1ee1d52efa95cc3b0db75271561df8f0d8e2c43add39c5ec08018af7a8a95108e7090f95a29f88727b7a40fd53d",
  "devDependencies": {
    "@book000/eslint-config": "1.15.37",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "10.14.0",
    "fauxcord": "github:tomacheese/fauxcord#fd50fbbc0aca42fbf5b7be53417fb33114c6ffac",
    "npm-run-all2": "9.0.4",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "claude-code-jsonl-parser": "0.1.3",
    "discord.js": "14.26.4",
    "tsx": "4.23.15",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  }
}
