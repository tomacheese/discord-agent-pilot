{
  "name": "discord-agent-pilot",
  "version": "0.0.0",
  "description": "A Discord bot that monitors and controls Claude Code running in tmux via Discord threads",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint:tsc": "tsc --noEmit",
    "lint:eslint": "eslint src/",
    "lint:prettier": "prettier --check src/",
    "lint": "run-s lint:*",
    "fix:eslint": "eslint src/ --fix",
    "fix:prettier": "prettier --write src/",
    "fix": "run-s fix:*"
  },
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1",
  "devDependencies": {
    "@book000/eslint-config": "1.15.37",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.13.2",
    "@vitest/coverage-v8": "4.1.9",
    "eslint": "10.6.0",
    "fauxcord": "github:tomacheese/fauxcord#fd50fbbc0aca42fbf5b7be53417fb33114c6ffac",
    "npm-run-all2": "9.0.2",
    "prettier": "3.9.4",
    "typescript": "6.0.3",
    "vitest": "4.1.9"
  },
  "dependencies": {
    "better-sqlite3": "12.11.1",
    "claude-code-jsonl-parser": "0.1.0",
    "discord.js": "14.26.4",
    "tsx": "4.23.0",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  }
}
