{
  "name": "discord-agent-pilot",
  "version": "0.0.0",
  "description": "A Discord bot that monitors and controls Claude Code running in tmux via Discord threads",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint:tsc": "tsc --noEmit",
    "lint:eslint": "eslint src/",
    "lint:prettier": "prettier --check src/",
    "lint": "run-s lint:*",
    "fix:eslint": "eslint src/ --fix",
    "fix:prettier": "prettier --write src/",
    "fix": "run-s fix:*"
  },
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3",
  "devDependencies": {
    "@book000/eslint-config": "1.15.37",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "fauxcord": "github:tomacheese/fauxcord#fd50fbbc0aca42fbf5b7be53417fb33114c6ffac",
    "npm-run-all2": "9.0.4",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "claude-code-jsonl-parser": "0.1.3",
    "discord.js": "14.28.1",
    "tsx": "4.23.15",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  }
}
